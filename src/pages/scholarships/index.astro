---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScholarshipCard from "../../components/ScholarshipCard.astro";
import allScholarships from "../../data/scholarships.json";

export const prerender = true;

const types = ['General Application', 'Stand Alone', 'Education Foundation'];
---

<Layout title="Scholarship Directory" description="Browse scholarships available through Truman Heartland Community Foundation.">
  <div class="page-banner">
    <div class="container">
      <h1 class="page-banner__title">Scholarship Directory</h1>
    </div>
  </div>

  <Breadcrumb />

  <div class="page-content">
    <div class="container">
      <p class="text-center" style="margin-bottom: var(--space-lg); max-width: 700px; margin-left: auto; margin-right: auto;">
        Truman Heartland Community Foundation holds over 250 scholarship funds to help students
        follow their dreams and work toward a brighter future. Use the filters below to find scholarships that match your needs.
      </p>

      <!-- Filters -->
      <div class="scholarship-filters" id="scholarship-filters">
        <div class="scholarship-filters__search">
          <input
            type="text"
            id="scholarship-search"
            placeholder="Search by name..."
            class="scholarship-filters__input"
            autocomplete="off"
          />
        </div>
        <div class="scholarship-filters__groups">
          <div class="scholarship-filters__group">
            <span class="scholarship-filters__label">Application Type</span>
            <div class="scholarship-filters__buttons">
              {types.map((type) => (
                <button class="filter-btn" data-filter="type" data-value={type}>{type}</button>
              ))}
            </div>
          </div>
          <div class="scholarship-filters__group">
            <span class="scholarship-filters__label">Renewal Status</span>
            <div class="scholarship-filters__buttons">
              <button class="filter-btn" data-filter="renewable" data-value="renewable">Renewable</button>
              <button class="filter-btn" data-filter="renewable" data-value="one-time">One-Time</button>
            </div>
          </div>
        </div>
        <div class="scholarship-filters__active" id="active-filters" style="display:none;">
          <span class="scholarship-filters__count" id="filter-count"></span>
          <button class="scholarship-filters__clear" id="clear-filters">Clear all filters</button>
        </div>
      </div>

      <!-- Grid -->
      <div class="scholarship-grid" id="scholarship-grid">
        {allScholarships.map((scholarship: any) => (
          <ScholarshipCard
            name={scholarship.name}
            slug={scholarship.slug}
            amount={scholarship.amount}
            applicationType={scholarship.applicationType}
            renewable={scholarship.renewable?.isRenewable ?? false}
          />
        ))}
      </div>

      <p class="scholarship-empty" id="scholarship-empty" style="display:none; text-align:center; padding: var(--space-2xl) 0; color: var(--color-text-light);">
        No scholarships match your filters. Try adjusting your search or clearing filters.
      </p>
    </div>
  </div>
</Layout>

<style>
  .scholarship-filters {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .scholarship-filters__search {
    max-width: 400px;
  }
  .scholarship-filters__input {
    width: 100%;
    padding: 0.625rem 1rem;
    border: 1.5px solid var(--color-gray-200);
    border-radius: 6px;
    font-size: var(--text-base);
    font-family: inherit;
    transition: border-color var(--transition-fast);
    background: white;
  }
  .scholarship-filters__input:focus {
    outline: none;
    border-color: var(--color-green);
  }
  .scholarship-filters__groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .scholarship-filters__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .scholarship-filters__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }
  .scholarship-filters__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: inherit;
    border: 1.5px solid var(--color-gray-200);
    border-radius: 4px;
    background: white;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .filter-btn:hover {
    border-color: var(--color-green);
    color: var(--color-green);
  }
  .filter-btn.is-active {
    background: var(--color-green);
    border-color: var(--color-green);
    color: white;
  }
  .scholarship-filters__active {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .scholarship-filters__count {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }
  .scholarship-filters__clear {
    font-size: var(--text-sm);
    font-family: inherit;
    color: var(--color-green);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }
  .scholarship-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
  @media (min-width: 640px) {
    .scholarship-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .scholarship-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  const grid = document.getElementById('scholarship-grid')!;
  const cards = Array.from(grid.querySelectorAll('.scholarship-card')) as HTMLElement[];
  const searchInput = document.getElementById('scholarship-search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn') as NodeListOf<HTMLButtonElement>;
  const activeBar = document.getElementById('active-filters')!;
  const countEl = document.getElementById('filter-count')!;
  const clearBtn = document.getElementById('clear-filters')!;
  const emptyMsg = document.getElementById('scholarship-empty')!;

  let activeType: string | null = null;
  let activeRenewal: string | null = null;

  function applyFilters() {
    const search = searchInput.value.toLowerCase().trim();
    let visible = 0;

    cards.forEach((card) => {
      const name = (card.querySelector('.scholarship-card__title')?.textContent ?? '').toLowerCase();
      const type = card.dataset.type ?? '';
      const renewable = card.dataset.renewable ?? '';

      const matchSearch = !search || name.includes(search);
      const matchType = !activeType || type === activeType;
      const matchRenewal = !activeRenewal || renewable === activeRenewal;

      const show = matchSearch && matchType && matchRenewal;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Update count bar
    const hasFilters = search || activeType || activeRenewal;
    activeBar.style.display = hasFilters ? 'flex' : 'none';
    countEl.textContent = `${visible} of ${cards.length} scholarships`;
    emptyMsg.style.display = visible === 0 ? 'block' : 'none';
  }

  searchInput.addEventListener('input', applyFilters);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;
      const value = btn.dataset.value!;

      if (filter === 'type') {
        activeType = activeType === value ? null : value;
      } else {
        activeRenewal = activeRenewal === value ? null : value;
      }

      // Update button states
      filterBtns.forEach((b) => {
        if (b.dataset.filter === filter) {
          const isActive = filter === 'type'
            ? b.dataset.value === activeType
            : b.dataset.value === activeRenewal;
          b.classList.toggle('is-active', isActive);
        }
      });

      applyFilters();
    });
  });

  clearBtn.addEventListener('click', () => {
    activeType = null;
    activeRenewal = null;
    searchInput.value = '';
    filterBtns.forEach((b) => b.classList.remove('is-active'));
    applyFilters();
  });
</script>
